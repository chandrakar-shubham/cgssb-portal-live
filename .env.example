# CGSSB Test Environment Configuration

# Application Port
PORT=3000

# Google Gemini API Key for AI Test Generation & Solved Paper Explanations
GEMINI_API_KEY=

# Database Mode: 'mysql' (Production with MySQL/PostgreSQL) or 'json' (Local Persistence)
DATABASE_MODE=json

# MySQL Database Configuration (Required if DATABASE_MODE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=cgssb_db
MYSQL_CONNECTION_LIMIT=30
