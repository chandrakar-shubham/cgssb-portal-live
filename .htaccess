<IfModule mod_rewrite.c>
  Options -MultiViews
  RewriteEngine On
  RewriteBase /

  # 1. DirectoryIndex: prioritize compiled dist/index.html, then root index.html, then index.php
  DirectoryIndex dist/index.html index.html index.php

  # 2. Block direct access to environment & secret repository files
  <FilesMatch "^\.env|^\.git|package\.json|tsconfig\.json|server\.ts">
    Require all denied
  </FilesMatch>

  # 3. Route /assets/* to dist/assets/* if dist/assets exists (Git clone deployment)
  RewriteCond %{DOCUMENT_ROOT}/assets/$1 !-f
  RewriteCond %{DOCUMENT_ROOT}/dist/assets/$1 -f
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

  # 4. Route nested asset requests (e.g. /admin/assets/*) to dist or root assets
  RewriteCond %{DOCUMENT_ROOT}/dist/assets/$1 -f
  RewriteRule ^.+?/assets/(.*)$ dist/assets/$1 [L]

  RewriteCond %{DOCUMENT_ROOT}/assets/$1 -f
  RewriteRule ^.+?/assets/(.*)$ assets/$1 [L]

  # 5. Serve real existing files and directories directly without rewriting
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 6. Fallback for hashed app script if an older client requests an obsolete hash:
  # Route missing app-*.js to dist/assets/index.js or assets/index.js if available
  RewriteCond %{DOCUMENT_ROOT}/dist/assets/$1 !-f
  RewriteCond %{DOCUMENT_ROOT}/dist/assets/index.js -f
  RewriteRule ^assets/app-.*\.js$ dist/assets/index.js [L]

  RewriteCond %{DOCUMENT_ROOT}/assets/$1 !-f
  RewriteCond %{DOCUMENT_ROOT}/assets/index.js -f
  RewriteRule ^assets/app-.*\.js$ assets/index.js [L]

  # 7. Prevent rewriting missing static assets (images, fonts, scripts) to HTML
  RewriteCond %{REQUEST_URI} \.(js|mjs|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|json|map)$ [NC]
  RewriteRule ^ - [R=404,L]

  # 8. Single Page Application (SPA) routing:
  # If dist/index.html exists (Hostinger Git repo clone mode), route all SPA routes to dist/index.html
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule ^ dist/index.html [L]

  # Otherwise fallback to root index.html (FTP deploy mode where dist/ contents are deployed directly to public_html)
  RewriteCond %{DOCUMENT_ROOT}/index.html -f
  RewriteRule ^ index.html [L]
</IfModule>

# -------------------------------------------------------------
# Caching & LiteSpeed: Prevent caching of index.html so updates reflect instantly
# -------------------------------------------------------------
<IfModule mod_rewrite.c>
  # Disable LiteSpeed web server cache for root HTML pages
  RewriteRule ^(index\.html)?$ - [E=Cache-Control:no-cache]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "(index\.html|version\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
    Header set X-LiteSpeed-Cache-Control "no-cache, no-store"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2|woff|ttf|png|jpg|jpeg|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# -------------------------------------------------------------
# MIME Types: Ensure modern JS modules & CSS are recognized
# -------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

