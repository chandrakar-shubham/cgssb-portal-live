<IfModule mod_rewrite.c>
  Options -MultiViews
  RewriteEngine On
  RewriteBase /

  # -------------------------------------------------------------
  # 1. MIME Types: Ensure modern JS modules & CSS are recognized
  # -------------------------------------------------------------
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff

  # -------------------------------------------------------------
  # 2. Security: Block direct access to environment & secret files
  # -------------------------------------------------------------
  <FilesMatch "^\.env">
    Require all denied
  </FilesMatch>

  # -------------------------------------------------------------
  # 3. Do not rewrite requests already pointing directly to dist/
  # -------------------------------------------------------------
  RewriteRule ^dist/ - [L]

  # -------------------------------------------------------------
  # 4. Fallback for any request for raw src/main (e.g. browser cache)
  # -------------------------------------------------------------
  RewriteRule ^src/main\.(tsx|ts|js)$ dist/index.html [L]

  # -------------------------------------------------------------
  # 5. Route compiled assets (/assets/...) to /dist/assets/...
  # -------------------------------------------------------------
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

  # -------------------------------------------------------------
  # 6. Route Root "/" or "/index.html" directly to dist/index.html
  # -------------------------------------------------------------
  RewriteRule ^$ dist/index.html [L]
  RewriteRule ^index\.html$ dist/index.html [L]

  # -------------------------------------------------------------
  # 7. Existing Files & Directories (except root index.html)
  # -------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # -------------------------------------------------------------
  # 8. SPA Fallback: Route /admin, /tests, and all client routes
  #    directly to dist/index.html
  # -------------------------------------------------------------
  RewriteRule ^.*$ dist/index.html [L]
</IfModule>

