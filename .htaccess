<IfModule mod_rewrite.c>
  Options -MultiViews
  RewriteEngine On
  RewriteBase /

  # -------------------------------------------------------------
  # MIME Types Configuration (Fixes text/plain script error)
  # -------------------------------------------------------------
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff

  # -------------------------------------------------------------
  # Security: Block direct access to raw TypeScript / source files
  # -------------------------------------------------------------
  <FilesMatch "\.(tsx|ts|env|lock)$">
    Require all denied
  </FilesMatch>

  # -------------------------------------------------------------
  # SCENARIO 1: Full Repository in public_html (dist/ folder present)
  # Automatically proxy/route all traffic through compiled dist/
  # -------------------------------------------------------------

  # 1.1 Root "/" or "/index.html" -> dist/index.html
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f [OR]
  RewriteCond dist/index.html -f
  RewriteRule ^(index\.html)?$ dist/index.html [L]

  # 1.2 Route assets directly if request matches /assets/...
  RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f [OR]
  RewriteCond dist%{REQUEST_URI} -f
  RewriteRule ^(assets/.*)$ dist/$1 [L]

  # 1.3 Route any file that exists inside dist/
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f [OR]
  RewriteCond dist%{REQUEST_URI} -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # 1.4 Single Page Application fallback (/admin, /tests, etc.) -> dist/index.html
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f [OR]
  RewriteCond dist/index.html -f
  RewriteRule ^.*$ dist/index.html [L]

  # -------------------------------------------------------------
  # SCENARIO 2: Standalone Static Build (dist contents in public_html)
  # -------------------------------------------------------------
  DirectoryIndex index.html index.php

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Direct all SPA routes (like /admin) to index.html
  RewriteRule . /index.html [L]
</IfModule>
