rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin writes are performed by the server Firebase Admin SDK.
    // Do not expose an admin role check here as a substitute for server authorization.

    // User profile: a signed-in user can only access their own document.
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Public exam/catalog content: browser reads are intentionally public.
    // All writes go through authenticated server APIs.
    match /mockTests/{testId} {
      allow read: if true;
      allow write: if false;
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if false;
    }

    match /pypPapers/{paperId} {
      allow read: if true;
      allow write: if false;
    }

    match /bundles/{bundleId} {
      allow read: if true;
      allow write: if false;
    }

    match /pages/{pageId} {
      allow read: if true;
      allow write: if false;
    }

    match /posts/{postId} {
      allow read: if true;
      allow write: if false;
    }

    match /seriesPacks/{packId} {
      allow read: if true;
      allow write: if false;
    }

    match /cmsSettings/{settingsId} {
      allow read: if true;
      allow write: if false;
    }

    match /slider_banners/{bannerId} {
      allow read: if true;
      allow write: if false;
    }

    // Current affairs is public content; mutations are server-admin only.
    match /currentAffairsSources/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /currentAffairsTopics/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /currentAffairsQuestions/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /dailyEditions/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /monthlyEditions/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /monthlyEditions/{docId}/sections/{sectionId} {
      allow read: if true;
      allow write: if false;
    }

    // Attempts are written by the trusted server submission endpoint.
    match /attempts/{attemptId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // User-specific application data is server/API controlled.
    match /userBookmarks/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /userMistakes/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /userEntitlements/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Referral records contain multiple users' data and are server controlled.
    match /referrals/{referralId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Server-driven configuration.
    match /remoteConfig/{configId} {
      allow read: if true;
      allow write: if false;
    }

    // Diagnostics should never be client-writable in production.
    match /_connection_check_/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Deny every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
