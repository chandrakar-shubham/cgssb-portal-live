<IfModule mod_rewrite.c>
  Options -MultiViews
  RewriteEngine On
  RewriteBase /

  # 1. Ensure index.html takes precedence over Hostinger default.php or index.php
  DirectoryIndex index.html index.php

  # 2. Block direct access to environment & secret repository files
  <FilesMatch "^\.env|^\.git|package\.json|tsconfig\.json|server\.ts">
    Require all denied
  </FilesMatch>

  # 3. Serve real existing files and directories directly without rewriting
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Route any sub-path asset requests (e.g. /admin/assets/* or /test/assets/*) to /assets/*
  RewriteCond %{DOCUMENT_ROOT}/assets/$1 -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/dist/assets/$1 -f
  RewriteRule ^.*?assets/(.*)$ assets/$1 [L]

  # 5. Prevent rewriting missing static assets to index.html
  # (Prevents "Failed to load module script: Expected JavaScript but got text/html" errors)
  RewriteCond %{REQUEST_URI} \.(js|mjs|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|json|map)$ [NC]
  RewriteRule ^ - [R=404,L]

  # 6. Fallback all non-existing routes to index.html for Single Page App routing
  RewriteRule ^ index.html [L]
</IfModule>

# -------------------------------------------------------------
# Caching: Prevent caching of index.html so updates reflect instantly
# -------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires 0
    Header set X-LiteSpeed-Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2|woff|ttf|png|jpg|jpeg|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# -------------------------------------------------------------
# MIME Types: Ensure modern JS modules & CSS are recognized
# -------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

